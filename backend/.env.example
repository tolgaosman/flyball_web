APP_NAME=Flyball
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
# "Today" in the AI prompts and the answer-cache TTL follow this timezone.
APP_TIMEZONE=UTC

# Gemini (https://aistudio.google.com/apikey). The key never leaves this server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# Ready-made rounds (per kind) and XOX boards kept warm by the queue worker.
# 0 = build everything on request (slower, uses less quota).
FLYBALL_BUFFER_TARGET=3

# SQLite: accounts + queue in DB_DATABASE, the disposable AI cache in its own file.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/flyball_app.sqlite
# AI_CACHE_DB_DATABASE=/absolute/path/flyball_cache.sqlite

# Locks (in-flight request dedupe) and the login throttle live in the file cache.
CACHE_STORE=file
QUEUE_CONNECTION=database
# Must exceed the TopUpBuffer job timeout (900 s).
DB_QUEUE_RETRY_AFTER=960
SESSION_DRIVER=array

# Lets `php artisan serve` handle concurrent requests in development.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
